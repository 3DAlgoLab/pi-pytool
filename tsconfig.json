{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"noUncheckedIndexedAccess": false,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": ["index.ts", "src/**/*.ts"]
}

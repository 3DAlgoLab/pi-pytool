{
	"name": "pi-pytool",
	"version": "0.1.0",
	"type": "module",
	"description": "A pi extension that adds one tool, pytool: a session-persistent Python kernel that lives alongside the agent's other tools.",
	"keywords": [
		"pi-package",
		"pi",
		"agent",
		"python",
		"repl",
		"com"
	],
	"license": "MIT",
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"files": [
		"src",
		"scripts",
		"index.ts",
		"bridge.py",
		"README.md"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"setup-venv": "node scripts/setup-venv.mjs",
		"postinstall": "node scripts/setup-venv.mjs",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
		"test": "bun test pytool-units",
		"test:integ": "bun test pytool-integration",
		"test:load": "bun test pytool-load",
		"check": "npm run typecheck && bun test pytool"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.4.0",
		"@types/bun": "^1.4.4",
		"@types/node": "^22.0.0",
		"typebox": "^1.3.11",
		"typescript": "^5.6.0"
	}
}
